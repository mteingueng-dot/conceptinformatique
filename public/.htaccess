# Concept Informatique — règles du serveur (cPanel / LiteSpeed ou Apache)
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Fichiers techniques jamais servis (suivi de la mise en ligne automatique, réglages PHP)
RewriteRule (^|/)\.(ftp-deploy-sync-state\.json|user\.ini)$ - [F,L]

# Une seule version du site : https + www (http:// et sans www -> redirection permanente)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.conceptinformatique.net%{REQUEST_URI} [L,R=301]

# Adresses en double -> adresse officielle (redirection permanente)
RewriteRule ^home/?$ / [L,R=301]
RewriteRule ^values/?$ /about/values/ [L,R=301]
RewriteRule ^values/([^/]+)/?$ /about/values/$1/ [L,R=301]
RewriteRule ^professional-profiles?/?$ /about/profil-professionnel/ [L,R=301]
RewriteRule ^professional-profiles/([^/]+)/?$ /about/profils/$1/ [L,R=301]
RewriteRule ^expertises/?$ /services/ [L,R=301]
# Anciennes pages « expertises » fusionnées avec les pages de services
RewriteRule ^(about/)?expertises/business-intelligence/?$ /services/business-intelligence/ [L,R=301]
RewriteRule ^(about/)?expertises/ingenierie-de-donnees/?$ /services/data-engineering/ [L,R=301]
RewriteRule ^(about/)?expertises/developpement-logiciel/?$ /services/developpement-logiciel/ [L,R=301]
RewriteRule ^(about/)?expertises/support-ti/?$ /services/support-ti-securite/ [L,R=301]
RewriteRule ^(about/)?expertises/automatisation-ia/?$ /services/automatisation-ia/ [L,R=301]
RewriteRule ^(about/)?expertises/transformation-numerique/?$ /services/transformation-numerique/ [L,R=301]
RewriteRule ^(about/)?expertises/ /services/ [L,R=301]

# Page pré-rendue demandée sans « / » final -> avec « / »
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# Fichiers et dossiers existants (pages pré-rendues, images, api/*.php) servis tels quels
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

</IfModule>

# Fichiers techniques jamais servis (suivi de la mise en ligne automatique, réglages PHP)
<FilesMatch "^(\.ftp-deploy-sync-state\.json|\.user\.ini)$">
  Require all denied
</FilesMatch>

# Adresse inexistante : vraie page « introuvable » (code 404, non indexée)
ErrorDocument 404 /404.html

# Cache : les .js et .css (dans assets/) changent de nom à chaque build
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
